# BeanFlow — variables de entorno
# Copiar a .env para uso local. NUNCA commitear .env.

# --- Backend (Spring Boot) ---
BEANFLOW_DB_URL=jdbc:postgresql://localhost:5432/beanflow
BEANFLOW_DB_USER=beanflow_user
BEANFLOW_DB_PASSWORD=cambiar
# Modo dev sin PostgreSQL:
# BEANFLOW_DB_URL=jdbc:h2:mem:beanflow;DB_CLOSE_DELAY=-1
# BEANFLOW_DB_USER=sa
# BEANFLOW_DB_PASSWORD=

# Obligatorio en produccion (HS256, >=32 bytes aleatorios):
BEANFLOW_JWT_SECRET=cambiar-por-secret-aleatorio-largo
BEANFLOW_JWT_HORAS=12
# true cuando el SSR este detras de HTTPS:
BEANFLOW_COOKIE_SECURE=false

# Usuario administrador inicial (solo si la tabla esta vacia):
BEANFLOW_SEED_CORREO=admin@beanflow.dev
BEANFLOW_SEED_CLAVE=cambiar

# --- Frontend SSR (Express) ---
# URL del backend al que el SSR proxea /api:
BEANFLOW_API_URL=http://localhost:8081
# Puerto del servidor SSR:
PORT=4001
